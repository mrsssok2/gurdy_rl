<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gurdy">

    <!-- Properties -->
    <xacro:property name="foot_kp" value="1000.0"/>
    <xacro:property name="foot_kd" value="1000.0"/>
    <xacro:property name="foot_mu1" value="10.0"/>
    <xacro:property name="foot_mu2" value="10.0"/>
    <xacro:property name="foot_radius" value="0.008"/>

    <!-- Masses and inertias. The masses are realistic; the head inertia is
         computed from its collision geometry with the solid-cylinder formula
         about its centre of mass:
           ixx = iyy = m(3r^2 + h^2)/12, izz = m r^2/2
         head_link   0.300 kg  cylinder r=0.05 h=0.04 -> 2.275e-4, 3.75e-4
         camera_link 0.001 kg  box 0.01^3
         upperleg    0.030 kg  cylinder r=0.0025 h=0.06
         lowerleg    0.030 kg  cylinder r=0.0015 h=0.06
         foot        0.010 kg  sphere r=0.008
         Total: 0.301 + 6 x 0.070 = 0.721 kg, ~7.07 N of weight.

         The thin links' inertias are INFLATED ON PURPOSE for solver
         stability, not computed from their geometry. The exact formulas give
         very lopsided tensors (lower leg ixx 9.0e-6 vs izz 3.4e-8, a ~270:1
         ratio; foot 2.6e-7; camera 1.7e-8), which ODE's iterative solver
         handles badly and which is the likely cause of the blow-up seen with
         them (every joint at an exact multiple of pi with zero std, odom all
         zeros, the legs gone from Gazebo). Instead they use a
         floor with a ratio of at most 10:1:
           upperleg, lowerleg  ixx = iyy = 1e-5, izz = 1e-6
           foot, camera        1e-6 on all axes
         The legs' ixx/iyy are only ~10% above the exact values, so the
         dynamics the hip and knee servos see (inertia about the joint y axis,
         dominated by the m d^2 offset terms: ~4.3e-4 kg m^2 at a straight
         hip, ~7.2e-5 kg m^2 at the knee) are essentially unchanged; izz is
         spin about each leg's own long axis, which no joint drives. Do not
         "correct" these back to the formula values. -->

    <!-- Joint limits. Worst-case static torque, one leg holding the whole
         robot (7.07 N) at full 0.12 m reach: ~0.85 N*m (hip), ~0.42 N*m
         (knee, 0.06 m reach). With three feet down it is about a third of
         that (~0.28 / ~0.14 N*m), so 1.0 N*m is a ~3.5x margin at the
         hip and still covers the whole robot on one leg. Under the p=10
         controllers it saturates at ~0.1 rad of error. 0.3 N*m was tried
         but saturated and the legs sagged short of their targets. The
         earlier blow-up at 1.0 N*m was traced to integral windup and the
         0.005 rad/s velocity limit, both since fixed (i_clamp 0.1,
         velocity 5.0). -->
    <xacro:property name="joint_effort" value="1.0"/>
    <!-- rad/s. 0.005 rad/s would need ~5 min for a 1.5 rad stroke. -->
    <xacro:property name="joint_velocity" value="5.0"/>
    <!-- Passive joint dynamics on all 12 leg joints: viscous damping in
         N*m*s/rad and Coulomb friction in N*m, to bleed off oscillation. -->
    <xacro:property name="joint_damping" value="0.05"/>
    <xacro:property name="joint_friction" value="0.01"/>

    <gazebo>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
        <bodyName>base_link</bodyName>
        <topicName>/gurdy/odom</topicName>
        <frameName>world</frameName>
        <updateRate>10.0</updateRate>
    </plugin>
</gazebo>

    <!-- Head XACRO -->
    <xacro:macro name="gurdy_head" params="">
        <link name="base_link">
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
            </collision>
            <visual>
                <origin xyz="0 0 0.01" rpy="0 0 0"/>
                <geometry>
                    <box size="0.01 0.01 0.01"/>
                </geometry>
            </visual>
        </link>

        <link name="head_link">
            <inertial>
                <origin xyz="0 0 0.02" rpy="0 0 0"/>
                <mass value="0.3" />
                <inertia ixx="2.275e-04" ixy="0.0" ixz="0.0" iyy="2.275e-04" iyz="0.0" izz="3.75e-04"/>
            </inertial>
            <collision>
                <origin xyz="0 0 0.02" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0.0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://my_gurdy_description/models/gurdy/meshes/gurdy_head_v2.dae"/>
                </geometry>
            </visual>
        </link>

        <gazebo reference="head_link">
            <mu1>10.0</mu1>
            <mu2>10.0</mu2>
        </gazebo>

        <joint name="fixed" type="fixed">
            <parent link="base_link"/>
            <child link="head_link"/>
        </joint>
    </xacro:macro>

    <!-- Camera XACRO -->
<xacro:macro name="gurdy_camera" params="">
    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.001" />
            <!-- Inflated for solver stability; see the inertia note at the top. -->
            <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.01 0.01 0.01"/>
            </geometry>
        </collision>
        <visual>
            <origin rpy="0.0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.01 0.01 0.01"/>
            </geometry>
        </visual>
    </link>

    <gazebo reference="camera_link">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- Modified joint for left-side table viewing -->
    <joint name="head_camera_joint" type="fixed">
        <parent link="head_link"/>
        <child link="camera_link"/>
        <!-- Position adjusted for left-side mounting with table viewing angle -->
        <origin xyz="0 -0.06 0.02" rpy="0 0 -2.0944"/>  <!-- -120 degrees to angle towards front-left -->
    </joint>

    <gazebo reference="camera_link">
        <sensor type="camera" name="camera1">
            <update_rate>30.0</update_rate>
            <camera name="head">
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>800</width>
                    <height>600</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <alwaysOn>true</alwaysOn>
                <updateRate>0.0</updateRate>
                <cameraName>gurdy/camera</cameraName>
                <imageTopicName>image_raw</imageTopicName>
                <cameraInfoTopicName>camera_info</cameraInfoTopicName>
                <frameName>camera_link</frameName>
                <hackBaseline>0.07</hackBaseline>
                <distortionK1>0.0</distortionK1>
                <distortionK2>0.0</distortionK2>
                <distortionK3>0.0</distortionK3>
                <distortionT1>0.0</distortionT1>
                <distortionT2>0.0</distortionT2>
            </plugin>
        </sensor>
    </gazebo>
</xacro:macro>

<!-- Add bumper sensor to the head -->
<gazebo reference="head">
  <sensor name="head_bumper" type="contact">
    <always_on>true</always_on>
    <update_rate>10.0</update_rate>
    <contact>
      <collision>head_collision</collision>
    </contact>
    <plugin name="gazebo_ros_bumper_controller" filename="libgazebo_ros_bumper.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>10.0</updateRate>
      <bumperTopicName>head_bumper</bumperTopicName>
      <frameName>head</frameName>
    </plugin>
  </sensor>
</gazebo>


    <!-- LEG -->
    <!-- MACROS -->
    <xacro:macro name="upperleg_link" params="number">
        <link name="upperleg_M${number}_link">
            <inertial>
                <origin xyz="0 0 0.03" rpy="0 0 0"/>
                <mass value="0.03" />
                <!-- Inflated for solver stability; see the inertia note at the top. -->
                <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-06"/>
            </inertial>
            <collision>
                <origin xyz="0 0 0.03" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.06" radius="0.0025"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0.0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://my_gurdy_description/models/gurdy/meshes/gurdy_higherleg_v2.dae"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>
    
    <xacro:macro name="lowerleg_link" params="number">
        <link name="lowerleg_M${number}_link">
            <inertial>
                <origin xyz="0 0 0.03" rpy="0 0 0"/>
                <mass value="0.03" />
                <!-- Inflated for solver stability; see the inertia note at the top. -->
                <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-06"/>
            </inertial>
            <collision>
                <origin xyz="0 0 0.03" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.06" radius="0.0015"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0.0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://my_gurdy_description/models/gurdy/meshes/gurdy_lowerleg_v2.dae"/>
                </geometry>
            </visual>
        </link>
        <joint name="upperlegM${number}_lowerlegM${number}_joint" type="revolute">
            <parent link="upperleg_M${number}_link"/>
            <child link="lowerleg_M${number}_link"/>
            <origin xyz="0 0.0095 0.06" rpy="0 0 3.14159"/>
            <!-- Upper limit 0: the knee may only fold one way (shin back under
                 the thigh). With +1.57 allowed, legs could buckle backwards on
                 landing after a reset and stay stuck in that mirrored pose. -->
            <limit lower="-2.9" upper="0.0" effort="${joint_effort}" velocity="${joint_velocity}"/>
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>
    
    <xacro:macro name="foot_link" params="number colour">
        <link name="footM${number}_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="0.01" />
                <!-- Inflated for solver stability; see the inertia note at the top. -->
                <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
            </inertial>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <sphere radius="${foot_radius}"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0.0 0 0" xyz="0 0 0"/>
                <geometry>
                    <sphere radius="${foot_radius}"/>
                </geometry>
            </visual>
        </link>
        <gazebo reference="footM${number}_link">
            <kp>${foot_kp}</kp>
            <kd>${foot_kd}</kd>
            <mu1>${foot_mu1}</mu1>
            <mu2>${foot_mu2}</mu2>
            <material>Gazebo/${colour}</material>
        </gazebo>
        <joint name="basefoot_peg_M${number}_basefoot_peg_M${number}_joint_joint" type="fixed">
            <parent link="lowerleg_M${number}_link"/>
            <child link="footM${number}_link"/>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="upper_transmission" params="number">
        <transmission name="tran_upper_M${number}">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="head_upperlegM${number}_joint">
                <hardwareInterface>EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="motor_upper_M${number}">
                <hardwareInterface>EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>
    
    <xacro:macro name="lower_transmission" params="number">
        <transmission name="tran_lower_M${number}">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="upperlegM${number}_lowerlegM${number}_joint">
                <hardwareInterface>EffortJointInterface</hardwareInterface>
            </joint>
            <actuator name="motor_lower_M${number}">
                <hardwareInterface>EffortJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>
    
    <xacro:macro name="gurdy_leg" params="headlink_name number colour *origin">
        <xacro:upperleg_link number="${number}"/>
        <xacro:upper_transmission number="${number}"/>

        <joint name="head_upperlegM${number}_joint" type="revolute">
            <parent link="${headlink_name}"/>
            <child link="upperleg_M${number}_link"/>
            <xacro:insert_block name="origin" />
            <limit lower="-1.55" upper="0.0" effort="${joint_effort}" velocity="${joint_velocity}"/>
            <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
            <axis xyz="0 1 0"/>
        </joint>
        
        <xacro:lowerleg_link number="${number}"/>
        <xacro:lower_transmission number="${number}"/>

        <xacro:foot_link number="${number}" colour="${colour}"/>
    </xacro:macro>

    <xacro:macro name="gurdy_control" params="namespace">
        <gazebo>
            <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
                <robotNamespace>/${namespace}</robotNamespace>
            </plugin>
        </gazebo>

        <gazebo>
            <plugin name="gazebo_ros_imu_controller" filename="libgazebo_ros_imu.so">
                <robotNamespace>/${namespace}</robotNamespace>
                <topicName>imu/data</topicName>
                <serviceName>imu/service</serviceName>
                <bodyName>base_link</bodyName>
                <gaussianNoise>0</gaussianNoise>
                <rpyOffsets>0 0 0</rpyOffsets>
                <updateRate>5.0</updateRate>
                <alwaysOn>true</alwaysOn>
                <gaussianNoise>0</gaussianNoise>
            </plugin>
        </gazebo>

        
    </xacro:macro>

    <!-- Instantiate all components -->
    <xacro:gurdy_head/>
    <xacro:gurdy_camera/>

    <xacro:gurdy_leg headlink_name="head_link" number="1" colour="Red">
        <origin xyz="-0.02165 -0.0125 -0.008" rpy="3.14159 0 0.523599"/>
    </xacro:gurdy_leg>

    <xacro:gurdy_leg headlink_name="head_link" number="2" colour="Green">
        <origin xyz="0.02165 -0.0125 -0.008" rpy="3.14159 0 2.61799"/>
    </xacro:gurdy_leg>

    <xacro:gurdy_leg headlink_name="head_link" number="3" colour="Blue">
        <origin xyz="0 0.025 -0.008" rpy="3.14159 0 -1.5708"/>
    </xacro:gurdy_leg>

    <xacro:gurdy_leg headlink_name="head_link" number="4" colour="Red">
        <origin xyz="-0.02165 0.0125 -0.008" rpy="3.14159 0 -0.523599"/>
    </xacro:gurdy_leg>

    <xacro:gurdy_leg headlink_name="head_link" number="5" colour="Green">
        <origin xyz="0.02165 0.0125 -0.008" rpy="3.14159 0 -2.61799"/>
    </xacro:gurdy_leg>
   <xacro:gurdy_leg headlink_name="head_link" number="6" colour="Blue">
        <origin xyz="0 -0.025 -0.008" rpy="3.14159 0 1.5708"/>
    </xacro:gurdy_leg>

    <xacro:gurdy_control namespace="gurdy"/>

</robot>