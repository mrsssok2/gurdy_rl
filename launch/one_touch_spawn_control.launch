<?xml version="1.0" encoding="UTF-8"?>

<launch>
    <!-- Define arguments -->
    <arg name="x" default="0.5" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.18" />

    <arg name="robot_name" default="gurdy" />
    <arg name="xacro_file_path" default="$(find my_gurdy_description)/robot/gurdy.xacro" />
    <!-- world: "empty" (default) or "demo" (worlds/gurdy_demo.world: a red
         ball, a blue box and a green box in front of the robot, for
         vision_node.py). Any other name loads worlds/gurdy_<name>.world. -->
    <arg name="world" default="empty" />
    <arg name="world_file" default="$(eval 'worlds/empty.world' if arg('world') == 'empty' else find('my_gurdy_description') + '/worlds/gurdy_' + arg('world') + '.world')" />
    <!-- gui:=false runs Gazebo headless (no gzclient window) -->
    <arg name="gui" default="true" />

    <!-- Load the URDF into the ROS Parameter Server -->
    <param name="robot_description" command="$(find xacro)/xacro $(arg xacro_file_path)" />

    <!-- Start Gazebo with the chosen world -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_file)" />
        <arg name="use_sim_time" value="true" />
        <arg name="gui" value="$(arg gui)" />
    </include>

    <!-- Run a python script to send a service call to gazebo_ros to spawn a URDF robot -->
    <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
          args="-urdf -x $(arg x) -y $(arg y) -z $(arg z) -model $(arg robot_name) -param robot_description" />

    <!-- Include the control launch file -->
    <include file="$(find my_gurdy_description)/launch/gurdy_control.launch"/>
</launch>
