<?xml version="1.0"?>
<!-- Computer-vision demo world: the empty world plus three static coloured
     objects on the ground for vision_node.py. Gurdy spawns at (0.5, 0)
     facing +x (one_touch_spawn_control.launch), and its camera sits 5.5 cm
     ahead of the base. Positions relative to the spawn point:
       red ball   6 cm   0.35 m ahead, 3 cm left      (straight ahead)
       blue box   8 cm   0.45 m ahead, 22 cm left     (~29 deg left)
       green box  8 cm   0.50 m ahead, 25 cm right    (~29 deg right)
     All three are inside the camera's 80 deg field of view at the start.
     Start with: roslaunch my_gurdy_description one_touch_spawn_control.launch world:=demo -->
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="red_ball">
      <static>true</static>
      <pose>0.85 0.03 0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_box">
      <static>true</static>
      <pose>0.95 0.22 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_box">
      <static>true</static>
      <pose>1.0 -0.25 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
